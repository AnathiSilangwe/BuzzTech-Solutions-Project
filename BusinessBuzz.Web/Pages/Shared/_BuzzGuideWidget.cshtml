@using BusinessBuzz.Core.Entities

@{
    var conversation = ViewData["BuzzGuideConversation"]
        as IEnumerable<BuzzGuideMessage>;
}

<div class="buzzguide-widget" id="buzzGuideWidget">
    <section class="buzzguide-panel"
             id="buzzGuidePanel"
             aria-label="BuzzGuide assistant"
             aria-hidden="true">

        <header class="buzzguide-header">
            <div class="buzzguide-avatar">
                <span aria-hidden="true">✦</span>
            </div>

            <div class="buzzguide-header-text">
                <strong>BuzzGuide</strong>
                <small>Your Business Buzz assistant</small>
            </div>

            <button type="button"
                    class="buzzguide-close"
                    id="buzzGuideClose"
                    aria-label="Close BuzzGuide">
                &times;
            </button>
        </header>

        <div class="buzzguide-messages" id="buzzGuideMessages">

            @if (conversation == null || !conversation.Any())
            {
                <div class="buzzguide-message buzzguide-message-assistant">
                    <strong>Hello, entrepreneur!</strong>
                    <p>
                        I'm BuzzGuide. I can help you understand your business
                        profile, registration requirements and next steps.
                    </p>
                </div>
            }
            else
            {
                @foreach (var message in conversation
                    .OrderBy(m => m.CreatedAt)
                    .ThenBy(m => m.BuzzGuideMessageId))
                {
                    var isEntrepreneur = message.Role == "Entrepreneur";

                    <div class="buzzguide-message @(isEntrepreneur
                        ? "buzzguide-message-user"
                        : "buzzguide-message-assistant")">
                        <strong>@(isEntrepreneur ? "You" : "BuzzGuide")</strong>
                        <p>@message.Message</p>
                    </div>
                }
            }

        </div>

        <div class="buzzguide-suggestions">
            <button type="button"
                    data-question="Help me review my business profile.">
                Review my profile
            </button>

            <button type="button"
                    data-question="Explain the CIPC registration process.">
                CIPC registration
            </button>

            <button type="button"
                    data-question="What should I do next in my business journey?">
                My next step
            </button>
        </div>

        <form method="post"
              asp-page="/Dashboard/Index"
              asp-page-handler="AskBuzzGuide"
              class="buzzguide-form"
              id="buzzGuideForm">

            <label class="visually-hidden" for="buzzGuideQuestion">
                Ask BuzzGuide a question
            </label>

            <input type="text"
                   id="buzzGuideQuestion"
                   name="BuzzGuideQuestion"
                   placeholder="Ask BuzzGuide anything..."
                   autocomplete="off"
                   maxlength="1000"
                   required />

            <button type="submit" aria-label="Send message">
                &#10148;
            </button>
        </form>

        <p class="buzzguide-footer">
            Business Buzz · Your journey, guided.
        </p>
    </section>

    <button type="button"
            class="buzzguide-launcher"
            id="buzzGuideLauncher"
            aria-label="Open BuzzGuide"
            aria-expanded="false"
            aria-controls="buzzGuidePanel">
        <span class="buzzguide-launcher-icon" aria-hidden="true">✦</span>
        <span class="buzzguide-launcher-label">Ask BuzzGuide</span>
    </button>
</div>
