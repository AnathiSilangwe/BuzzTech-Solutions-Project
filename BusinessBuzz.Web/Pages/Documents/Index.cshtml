@page
@model BusinessBuzz.Web.Pages.Documents.IndexModel
@{
    ViewData["Title"] = "My Documents";
}

<h2>My Documents</h2>
<p>
    View documents associated with your business profile.
</p>

@if (!Model.Documents.Any())
{
    <p>
        You have not generated or uploaded any documents yet.
    </p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Document Type</th>
                <th>Date Added</th>
                <th>Source</th>
                <th>Verification Status</th>
            </tr>
        </thead>
            <tbody>
            @foreach (var document in Model.Documents)
            {
                <tr>
                    <td>
                        @document.DocumentType.TypeName
                    </td>
                    <td>
                        @document.UploadedAt.ToLocalTime().ToString("g")
                    </td>
                    <td>
                        @(document.IsSystemGenerated? "Generated by BusinessBuzz" : "Uploaded by Entrepreneur")
                    </td>
                    <td>
                        @(document.IsVerified ? "Verified" : "Not Verified" )
                    </td>
                </tr>
            }
        </tbody>
    </table>
    

}
<p>
    <a asp-page="/Documents/Generate">Generate a DigiDoc</a>
</p>
<p>
    <a asp-page="/Dashboard/Index">Back to Dashboard</a>
</p>