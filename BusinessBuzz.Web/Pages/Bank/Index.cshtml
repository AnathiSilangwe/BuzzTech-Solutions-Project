@page
@model BusinessBuzz.Web.Pages.Bank.IndexModel

@{
    Layout = "/Pages/Shared/_BankLayout.cshtml";
    ViewData["Title"] = "Banker Portal";
}

<header class="bank-header">
    <div>
        <h1>Banker Dashboard</h1>
        <p>Review business funding enquiries and record simulated assessment decisions.</p>
    </div>

    <span class="demo-badge">DEMO ENVIRONMENT</span>
</header>

<section class="bank-stats" aria-label="Dashboard statistics">
    <article class="stat-card">
        <h3>Pending Enquiries</h3>
        <strong>@Model.PendingAssessments.Count</strong>
    </article>

    <article class="stat-card">
        <h3>Completed Assessments</h3>
        <strong>@Model.CompletedAssessments.Count</strong>
    </article>

    <a asp-page="/Bank/Notifications" class="stat-card" style="text-decoration: none; color: inherit;">
        <h3>Unread Notifications</h3>
        <strong>@Model.UnreadNotifications</strong>
        <span>View notifications →</span>
    </a>

    <article class="stat-card">
        <h3>Portal Status</h3>
        <strong style="font-size: 20px;">Active</strong>
    </article>
</section>

<section class="bank-panel" id="pending-enquiries">
    <div class="panel-heading">
        <h2>Pending Funding Enquiries</h2>
        <p>Review business information before recording an assessment outcome.</p>
    </div>

    @if (Model.PendingAssessments.Count == 0)
    {
        <p class="empty-message">
            There are currently no pending funding enquiries.
            New enquiries will appear here when entrepreneurs submit them.
        </p>
    }
    else
    {
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Business</th>
                        <th>Business Type</th>
                        <th>Industry</th>
                        <th>Submitted</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var enquiry in Model.PendingAssessments)
                    {
                        <tr>
                            <td>
                                @(string.IsNullOrWhiteSpace(enquiry.BusinessProfile?.BusinessName)
                                    ? "Unnamed business"
                                    : enquiry.BusinessProfile.BusinessName)
                            </td>
                            <td>
                                @(enquiry.BusinessProfile?.BusinessType?.TypeName ?? "Not specified")
                            </td>
                            <td>
                                @(string.IsNullOrWhiteSpace(enquiry.BusinessProfile?.Industry)
                                    ? "Not specified"
                                    : enquiry.BusinessProfile.Industry)
                            </td>
                            <td>@enquiry.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td>
                                <a asp-page="/Bank/Enquiry/Details"
                                   asp-route-id="@enquiry.FundingAssessmentId"
                                   class="review-button">
                                    Review
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="bank-panel" id="assessment-history" style="margin-top: 25px;">
    <div class="panel-heading">
        <h2>Assessment History</h2>
        <p>View funding assessments that have already been recorded.</p>
    </div>

    @if (Model.CompletedAssessments.Count == 0)
    {
        <p class="empty-message">No assessments have been completed yet.</p>
    }
    else
    {
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Business</th>
                        <th>Outcome</th>
                        <th>Banker</th>
                        <th>Assessed On</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var assessment in Model.CompletedAssessments)
                    {
                        <tr>
                            <td>
                                @(assessment.BusinessProfile?.BusinessName ?? "Unnamed business")
                            </td>
                            <td>
                                <span class="status-pill @(assessment.SimulatedOutcome == "Approved" ? "status-approved" : assessment.SimulatedOutcome == "Declined" ? "status-declined" : "status-under-review")">
                                    @assessment.SimulatedOutcome
                                </span>
                            </td>
                            <td>@(assessment.BankUser?.Email ?? "Not assigned")</td>
                            <td>
                                @(assessment.AssessedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")
                            </td>
                            <td>
                                <a asp-page="/Bank/Enquiry/Details"
                                   asp-route-id="@assessment.FundingAssessmentId"
                                   class="review-button">
                                    View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<p class="bank-footer">
    All funding outcomes in this prototype are simulated and do not represent real lending decisions.
</p>