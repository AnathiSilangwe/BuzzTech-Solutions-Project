@page
@model BusinessBuzz.Web.Pages.Bank.IndexModel

@{
    ViewData["Title"] = "Banker Portal";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Banker Portal</h1>
            <p class="text-muted">
                Review business funding enquiries and record simulated assessment decisions.
            </p>
        </div>
        <div class="text-end">
            <span class="badge bg-primary">
                Unread notifications: @Model.UnreadNotifications
            </span>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5>Pending Enquiries</h5>
                    <h2>@Model.PendingAssessments.Count</h2>
                    <p class="text-muted mb-0">Awaiting assessment</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5>Completed Assessments</h5>
                    <h2>@Model.CompletedAssessments.Count</h2>
                    <p class="text-muted mb-0">Decisions recorded</p>
                </div>
            </div>
        </div>
    </div>

    <section class="card shadow-sm mb-4">
        <div class="card-header">
            <h2 class="h5 mb-0">Pending Funding Enquiries</h2>
        </div>
        <div class="card-body">
            @if (Model.PendingAssessments.Count == 0)
            {
                <p class="mb-0">
                    There are currently no pending funding enquiries.
                    New enquiries will appear here when entrepreneurs submit them.
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Business</th>
                                <th>Business Type</th>
                                <th>Industry</th>
                                <th>Submitted</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var enquiry in Model.PendingAssessments)
                            {
                                <tr>
                                    <td>
                                        @(enquiry.BusinessProfile?.BusinessName ?? "Unnamed business")
                                    </td>
                                    <td>
                                        @(enquiry.BusinessProfile?.BusinessType?.TypeName ?? "Not specified")
                                    </td>
                                    <td>
                                        @(enquiry.BusinessProfile?.Industry ?? "Not specified")
                                    </td>
                                    <td>
                                        @enquiry.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </td>
                                    <td>
                                        <a asp-page="/Bank/Enquiry/Details" asp-route-id="@enquiry.FundingAssessmentId" class="btn btn-primary btn-sm">
                                        View Details
                                        </a>
                                        
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <section class="card shadow-sm">
        <div class="card-header">
            <h2 class="h5 mb-0">Assessment History</h2>
        </div>
        <div class="card-body">
            @if (Model.CompletedAssessments.Count == 0)
            {
                <p class="mb-0">No assessments have been completed yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Business</th>
                                <th>Outcome</th>
                                <th>Banker</th>
                                <th>Assessed On</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var assessment in Model.CompletedAssessments)
                            {
                                <tr>
                                    <td>
                                        @(assessment.BusinessProfile?.BusinessName ?? "Unnamed business")
                                    </td>
                                    <td>@assessment.SimulatedOutcome</td>
                                    <td>
                                        @(assessment.BankUser?.Email ?? "Not assigned")
                                    </td>
                                    <td>
                                        @(assessment.AssessedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <p class="text-muted small mt-3">
        Business Buzz uses simulated funding assessments for demonstration purposes.
        This portal does not make real lending decisions.
    </p>
</div>