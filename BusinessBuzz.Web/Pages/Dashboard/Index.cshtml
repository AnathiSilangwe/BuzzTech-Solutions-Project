@page
@model BusinessBuzz.Web.Pages.Dashboard.IndexModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-5">
    <h1>Welcome to Business Buzz</h1>

    <p>
        This is your entrepreneur dashboard.
    </p>

    <p>
        Logged in as: <strong>@Model.UserEmail</strong>
    </p>

    <p>
        From here, you will be able to manage your business profile,
        follow your personalised journey, access documents, and interact
        with BuzzGuide.
    </p>
</div>