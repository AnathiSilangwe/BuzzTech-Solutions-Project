@page
@model BusinessBuzz.Web.Pages.Dashboard.IndexModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-5">

    <h1>Welcome to Business Buzz</h1>

    <p>
        Logged in as: <strong>@Model.UserEmail</strong>
    </p>

    @if (!Model.HasBusinessProfile)
    {
        <div class="alert alert-info">
            <h4>Complete your business profile</h4>

            <p>
                Tell us about your business so we can personalise your journey.
            </p>

            <a asp-page="/BusinessProfile/Create" class="btn btn-primary">
                Create Business Profile
            </a>
        </div>
    }
        @if (Model.HasBusinessProfile)
    {
        <div class="card p-4 mt-4">
            <h3>Your Business Journey</h3>

            @if (Model.PersonalisedJourney.Count == 0)
            {
                <p>No journey stages are currently available.</p>
            }
            else
            {
                @foreach (var stage in Model.PersonalisedJourney)
                {
                    <div class="mb-4">
                        <h4>@stage.StageOrder. @stage.StageName</h4>

                        <p>
                            <strong>Institution:</strong>
                            @stage.InstitutionName
                        </p>

                        <p>
                            @stage.StageDescription
                        </p>

                        <p>
                            <strong>Type:</strong>
                            @stage.StageType
                        </p>

                        <p>
                            <strong>Required:</strong>
                            @(stage.IsRequired ? "Yes" : "No")
                        </p>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <div class="card p-4 mt-4">
            <h3>Your Business Profile</h3>

            <p>
                <strong>Business Name:</strong>
                @Model.BusinessName
            </p>

            <p>
                <strong>Business Type:</strong>
                @Model.BusinessType
            </p>

            <p>
                <strong>Industry:</strong>
                @Model.Industry
            </p>

            <p>
                <strong>Location:</strong>
                @Model.BusinessLocation
            </p>

            <p>
                <strong>Employs People:</strong>
                @(Model.EmploysPeople == true ? "Yes" : "No")
            </p>

            <p>
                <strong>Profile Confirmed:</strong>
                @(Model.IsProfileConfirmed == true ? "Yes" : "No")
            </p>
        </div>
    }
    <hr />

        <h3>BuzzGuide Context Test</h3>

        @if (Model.BuzzGuideContext != null)
        {
            <p>
                <strong>Business Name:</strong>
                @Model.BuzzGuideContext.BusinessName
            </p>

            <p>
                <strong>Business Type:</strong>
                @Model.BuzzGuideContext.BusinessType
            </p>

            <p>
                <strong>Industry:</strong>
                @Model.BuzzGuideContext.Industry
            </p>

            <p>
                <strong>Location:</strong>
                @Model.BuzzGuideContext.BusinessLocation
            </p>

            <p>
                <strong>Employs People:</strong>
                @Model.BuzzGuideContext.EmploysPeople
            </p>

            <p>
                <strong>Seeks Funding:</strong>
                @Model.BuzzGuideContext.SeeksFunding
            </p>

            <h4>Journey Context</h4>

           @foreach (var stage in Model.BuzzGuideContext.Journey)
            {
                <div>
                    <strong>
                        @stage.StageOrder. @stage.StageName
                    </strong>

                    - @stage.InstitutionName
                    - @stage.StageType

                    <br />

                    <strong>Application Status:</strong>
                    @(stage.ApplicationStatus ?? "Not Started")
                </div>

                <br />
            }
        }
        else
        {
            <p>BuzzGuide context could not be loaded.</p>
        }
    <hr />

<h3>BuzzGuide</h3>

<p>
    Ask BuzzGuide a question about your business journey.
</p>

<form method="post" asp-page-handler="AskBuzzGuide">

    <div>
        <label asp-for="BuzzGuideQuestion"></label>
        <input asp-for="BuzzGuideQuestion"
               placeholder="Ask BuzzGuide something..."
               autocomplete="off" />
    </div>

    <button type="submit">
        Ask BuzzGuide
    </button>

</form>

@if (!string.IsNullOrWhiteSpace(Model.BuzzGuideResponse))
{
    <div>
        <strong>BuzzGuide:</strong>
        <p>@Model.BuzzGuideResponse</p>
    </div>
}
</div>