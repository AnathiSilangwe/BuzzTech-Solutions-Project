@page
@model BusinessBuzz.Web.Pages.Development.CreateApproverModel

@{
    ViewData["Title"] = "Create Test Approver";
}

<h1>Create Test Approver</h1>

<p>This temporary page is available only in the Development environment.</p>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-info">@Model.Message</div>
}

<form method="post">
    <div class="mb-3">
        <label asp-for="SetupKey" class="form-label">Setup key</label>
        <input asp-for="SetupKey" type="password" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Approver email</label>
        <input asp-for="Email" type="email" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label">Approver password</label>
        <input asp-for="Password" type="password" class="form-control"
               minlength="8" required />
    </div>

    <button type="submit" class="btn btn-primary">Create Approver Account</button>
</form>
