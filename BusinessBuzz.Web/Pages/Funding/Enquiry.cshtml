@page
@model BusinessBuzz.Web.Pages.Funding.EnquiryModel

@{
    ViewData["Title"] = "Funding Enquiry";
}

<div class="container py-5">

    <a asp-page="/Dashboard/Index"
       class="text-decoration-none">
        &larr; Back to dashboard
    </a>

    <div class="mt-4 mb-4">
        <h1>Funding Enquiry</h1>
        <p class="text-muted">
            Submit your business for a simulated funding assessment.
            A banker can review your business profile and preparation
            information through Business Buzz.
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success">
            @Model.SuccessMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.InfoMessage))
    {
        <div class="alert alert-info">
            @Model.InfoMessage
        </div>
    }

    @if (Model.Profile != null)
    {
        <div class="card border-0 shadow-sm p-4 mb-4">
            <h4>Your business</h4>

            <p class="mb-1">
                <strong>Business name:</strong>
                @Model.Profile.BusinessName
            </p>

            <p class="mb-0">
                <strong>Business type:</strong>
                @Model.Profile.BusinessType
            </p>
        </div>
    }

    <div class="card border-0 shadow-sm p-4 mb-4">
        <h4>Request a funding review</h4>

        <p>
            By submitting, you ask a banker using the Business Buzz
            prototype to review your business information and record
            a simulated assessment.
        </p>

        <p class="small text-muted">
            This is a prototype workflow. It does not submit an
            application to a real bank or guarantee funding.
        </p>

        @if (Model.Assessments.Any(a => a.Status == "Pending"))
        {
            <button type="button"
                    class="btn btn-secondary"
                    disabled>
                Enquiry awaiting review
            </button>

            <p class="small text-muted mt-2 mb-0">
                You already have a pending enquiry for this business.
            </p>
        }
        else
        {
            <form method="post"
                  asp-page-handler="Submit"
                  onsubmit="return confirm('Submit your business for a simulated funding review?');">

                <button type="submit" class="btn btn-primary">
                    Submit Funding Enquiry
                </button>
            </form>
        }
    </div>

    <div class="card border-0 shadow-sm p-4">
        <h4 class="mb-3">Enquiry History</h4>

        @if (!Model.Assessments.Any())
        {
            <p class="text-muted mb-0">
                You have not submitted a funding enquiry yet.
            </p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Submitted</th>
                            <th>Status</th>
                            <th>Outcome</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var assessment in Model.Assessments)
                        {
                            <tr>
                                <td>
                                    @assessment.SubmittedAt
                                        .ToLocalTime()
                                        .ToString("dd MMM yyyy, HH:mm")
                                </td>
                                <td>
                                    @if (assessment.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending review
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Completed
                                        </span>
                                    }
                                </td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(
                                        assessment.SimulatedOutcome)
                                        ? "Awaiting assessment"
                                        : assessment.SimulatedOutcome)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="alert alert-info mt-4">
        <strong>Note:</strong>
        A completed assessment is a simulated result from the
        prototype, not an actual bank lending decision.
    </div>

</div>