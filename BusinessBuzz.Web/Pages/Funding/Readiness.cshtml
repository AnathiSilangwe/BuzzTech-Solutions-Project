
@page
@model BusinessBuzz.Web.Pages.Funding.ReadinessModel

@{
    ViewData["Title"] = "Funding Readiness";
}

<div class="container py-5">
    <a asp-page="/Dashboard/Index"
       class="text-decoration-none">
        &larr; Back to dashboard
    </a>

    <div class="mt-4 mb-4">
        <h1>Funding Readiness</h1>
        <p class="text-muted">
            Prepare your business information before approaching
            a potential funding provider.
        </p>
    </div>

    <div class="card border-0 shadow-sm p-4 mb-4">
        <div class="d-flex justify-content-between
                    align-items-center mb-2">
            <h5>Your preparation progress</h5>
            <strong>@Model.Progress%</strong>
        </div>

        <div class="progress mb-3" style="height: 12px;">
            <div class="progress-bar"
                 role="progressbar"
                 style="width: @Model.Progress%"
                 aria-valuenow="@Model.Progress"
                 aria-valuemin="0"
                 aria-valuemax="100">
            </div>
        </div>

        <p class="mb-0">
            @Model.CompletedCount of @Model.Tasks.Count
            preparation tasks completed.
        </p>
    </div>

    <div class="card border-0 shadow-sm p-4">
        <h3 class="mb-3">Your funding preparation checklist</h3>

        @foreach (var task in Model.Tasks)
        {
            <div class="d-flex justify-content-between
                        align-items-center gap-3
                        border-bottom py-3">

                <div>
                    <strong>
                        @(task.IsComplete ? "✓ " : "")
                        @task.TaskName
                    </strong>

                    <div class="small text-muted">
                        @(task.IsComplete
                            ? "Completed"
                            : "Still to do")
                    </div>
                </div>

                <form method="post"
                      asp-page-handler="Toggle">
                    <input type="hidden"
                           name="taskId"
                           value="@task.ReadinessTaskId" />

                    <button type="submit"
                            class="btn @(task.IsComplete
                                ? "btn-outline-secondary"
                                : "btn-primary")">
                        @(task.IsComplete
                            ? "Undo"
                            : "Mark complete")
                    </button>
                </form>
            </div>
        }
    </div>

    <div class="alert alert-info mt-4">
        <strong>Remember:</strong>
        This checklist measures your preparation.
        It does not guarantee funding or represent a real
        bank lending decision. Complete official CIPC and
        SARS processes through their respective services.
    </div>
</div>
