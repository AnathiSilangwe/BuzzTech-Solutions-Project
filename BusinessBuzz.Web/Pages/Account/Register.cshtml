@page
@model BusinessBuzz.Web.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Create Account | Business Buzz";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"]</title>

        <link rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />
        <link rel="stylesheet"
            href="~/css/main.css" asp-append-version="true" />
        <link rel="stylesheet"
            href="~/css/signup.css" asp-append-version="true" />
    </head>
    <body class = "auth-body">
        <main class="auth-page">
            <a asp-page="/Index" class="auth-logo">Business Buzz</a>
                <div class="auth-heading">
                    <h1>Create your account</h1>
                        <p>Start your guided business journey.</p>
                        <div class="auth-card">
                            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                            {
                                <div class="alert alert-danger">
                                    @Model.ErrorMessage
                                </div>
                            }

                            <form method="post" id= "signupForm">
                                        <div class="mb-3">
                                            <label asp-for="Name" class="form-label">Full Name</label>
                                            <input asp-for="Name"
                                                class="form-control"
                                                placeholder="Enter your full name"
                                                autocomplete="name"
                                                required />
                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="Email" class="form-label">
                                                Email Address
                                            </label>

                                            <input asp-for="Email"
                                                type="email"
                                                class="form-control"
                                                placeholder="Enter your email address" />

                                        </div>

                                        <div class="mb-3">
                                            <label asp-for="Password" class="form-label">
                                                Password
                                            </label>

                                            <input asp-for="Password"
                                                id="password"
                                                type="password"
                                                class="form-control"
                                                placeholder="Create a password"
                                                autocomplete="new-password"
                                                required />
                                        </div>

                                        <div class="mb-4">
                                            <label asp-for="ConfirmPassword" class="form-label">
                                                Confirm Password
                                            </label>

                                            <input asp-for="ConfirmPassword"
                                                id="confirmPassword"
                                                type="password"
                                                class="form-control"
                                                placeholder="Re-enter your password"
                                                autocomplete="new-password"
                                                required />
                                        </div>

                                        <button type="submit"
                                                class="btn btn-primary w-100">
                                            Create Account
                                        </button>

                                    </form>

                                    <div class="text-center mt-3">
                                        <span class="text-muted">
                                            Already have an account?
                                        </span>

                                        <a asp-page="/Account/Login">
                                            Log in
                                        </a>
                                     </div>
                </div>
        </main>
        <script src="~/js/Signup.js" asp-append-version="true"></script>
    </body>
</html>
        