@page
@model BusinessBuzz.Web.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Log In | Business Buzz";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"]</title>

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet" />
        <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    </head>
    <body class="auth-body">

        <div class="auth-page">
            <a asp-page="/Index" class="auth-logo">Business Buzz</a>

            <div class="auth-heading">
                <h1>Welcome back</h1>
                <p>Log in to continue your journey.</p>
            </div>

            <div class="auth-card">

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="auth-error" role="alert">
                        @Model.ErrorMessage
                    </div>
                }

                <form method="post" id="loginForm">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">
                            Email Address
                        </label>

                        <input asp-for="Email"
                            type="email"
                            class="form-control"
                            placeholder="Enter your email address"
                            autocomplete="username"
                            required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">
                            Password
                        </label>

                        <input asp-for="Password"
                            type="password"
                            class="form-control"
                            placeholder="Enter your password"
                            autocomplete="current-password"
                            required />
                    </div>

                    <button type="submit" class="auth-primary-btn">
                        Log In
                    </button>

                </form>

                <p class="text-center mt-3 mb-0">
                    <a href="#" class="forgot-password">Forgot Password?</a>
                </p>

                <div class="auth-divider"></div>

                <p class="auth-switch">
                    Don't have an account?
                    <a asp-page="/Account/Register">Create Account</a>
                </p>

            </div>

            <p class="auth-terms">
                By continuing, you agree to our Terms of Service and Privacy Policy.
            </p>
        </div>
        <script src="~/js/Login.js" asp-append-version="true"></script>
    </body>
</html>