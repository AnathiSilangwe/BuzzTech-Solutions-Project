@page
@model IndexModel

@{
    ViewData["Title"] = "Home";
    ViewData["HideNavbar"] = true;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/home.css"
          asp-append-version="true" />
}

<section class="bb-home-hero">
    <div class="bb-hero-content">

        <p class="bb-hero-label">
            SOUTH AFRICAN BUSINESS PLATFORM
        </p>

        <h1 class="bb-hero-title">
            From Business Idea
            <br class="d-none d-md-block" />
            to Business Ready.
        </h1>

        <p class="bb-hero-description">
            Business Buzz helps you understand, prepare for and
            track the steps involved in building your business.
        </p>

        <div class="bb-hero-buttons">
            <a asp-page="/Account/Register"
               class="bb-btn bb-btn-primary">
                Start Your Journey
                <span aria-hidden="true">&rarr;</span>
            </a>

            <a href="#how-it-works"
               class="bb-btn bb-btn-secondary">
                Learn How It Works
            </a>
        </div>

    </div>

    <div class="bb-hero-bottom">
        YOUR IDEA. YOUR JOURNEY. YOUR FUTURE.
    </div>
</section>

<main class="bb-home-features" id="how-it-works">

    <div class="bb-features-heading">
        <p class="bb-section-label">
            BUILT FOR YOUR JOURNEY
        </p>

        <h2>
            Everything you need to start with confidence
        </h2>

        <p>
            Business Buzz brings the important parts of your
            business journey together in one place.
        </p>
    </div>

    <div class="bb-feature-grid">

        <article class="bb-feature-card">
            <span class="bb-feature-number">01</span>

            <h3>BuzzGuide</h3>

            <p>
                Get personalised guidance based on your business
                idea and where you are in your entrepreneurial
                journey with your AI assistant.
            </p>
        </article>

        <article class="bb-feature-card">
            <span class="bb-feature-number">02</span>

            <h3>Business Documents</h3>

            <p>
                Keep track of the documents you need and access
                generated documents through your Business Buzz
                profile.
            </p>
        </article>

    </div>

</main>