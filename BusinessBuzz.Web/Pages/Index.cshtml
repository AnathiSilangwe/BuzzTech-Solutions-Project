@page
@model IndexModel
@{
    Layout = null;
ViewData["Title"] = "Home";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/main.css"
          asp-append-version="true" />
}

<section class="hero-section">
    <div class="container text-center">
        <p class="hero-label">
            SOUTH AFRICAN BUSINESS PLATFORM
        </p>

        <h1 class="hero-title">
            From Business Idea
            <br class="d-none d-md-block" />
            to Business Ready.
        </h1>

        <p class="hero-description">
            Business Buzz helps you understand, prepare for and
            track the steps involved in building your business.
        </p>

        <div class="hero-buttons">
            <a asp-page="/Account/Register"
               class="btn btn-start">
                Start Your Journey
            </a>

            <a href="#how-it-works"
               class="btn btn-learn">
                Learn How It Works
            </a>
        </div>
    </div>
</section>

<div class="row mt-5 pt-5">
    <div class="col-12 text-center mb-4">
        <h2 class="fw-bold">Everything you need to start with confidence</h2>
        <p class="text-muted">
            Business Buzz brings the important parts of your business journey together.
        </p>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm border-0 p-4">
            <h4 class="fw-bold">BuzzGuide</h4>
            <p class="text-muted">
                Get personalised guidance based on your business idea and
                where you are in your entrepreneurial journey with the AI assistat.
            </p>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm border-0 p-4">
            <h4 class="fw-bold">Business Documents</h4>
            <p class="text-muted">
                Keep track of the documents you need and access generated
                documents through your Business Buzz profile.
            </p>
        </div>
    </div>

   @*  <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm border-0 p-4">
            <h4 class="fw-bold">Funding Readiness</h4>
            <p class="text-muted">
                Understand what may be required when preparing your business
                for potential funding opportunities.
            </p>
        </div>
    </div> *@
</div>