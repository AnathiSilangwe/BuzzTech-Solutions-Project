@page
@model BusinessBuzz.Web.Pages.Notifications.IndexModel

@{
    ViewData["Title"] = "My Notifications";

    var unreadCount = Model.Notifications.Count(n => !n.IsRead);
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/notifications.css"
          asp-append-version="true" />
}

<div class="notifications-page">
    <header class="notifications-header">
        <div>
            <span class="notifications-eyebrow">BUSINESS BUZZ</span>
            <h1>My Notifications</h1>
            <p>Stay up to date with your business applications and next steps.</p>
        </div>

        <div class="notifications-overview">
            <span class="notifications-overview-icon" aria-hidden="true">♢</span>
            <div>
                <strong>@unreadCount</strong>
                <span>Unread</span>
            </div>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="notification-alert notification-alert-success"
             role="status">
            <span aria-hidden="true">✓</span>
            <p>@Model.SuccessMessage</p>
        </div>
    }

    <section class="notifications-content">
        <div class="notifications-section-heading">
            <div>
                <h2>All notifications</h2>
                <p>Your latest updates, newest first.</p>
            </div>

            <span class="notifications-total">
                @Model.Notifications.Count
                @(Model.Notifications.Count == 1 ? "notification" : "notifications")
            </span>
        </div>

        @if (Model.Notifications.Count == 0)
        {
            <div class="notifications-empty">
                <div class="notifications-empty-icon" aria-hidden="true">♢</div>
                <h3>You're all caught up!</h3>
                <p>
                    You don't have any notifications yet.
                    Updates about your business journey will appear here.
                </p>
                <a asp-page="/Dashboard/Index" class="notifications-primary-btn">
                    Return to dashboard
                </a>
            </div>
        }
        else
        {
            <div class="notifications-list">
                @foreach (var notification in Model.Notifications)
                {
                    <article class="notification-card @(notification.IsRead ? "is-read" : "is-unread")">
                        <div class="notification-indicator" aria-hidden="true">
                            @(notification.IsRead ? "✓" : "•")
                        </div>

                        <div class="notification-details">
                            <div class="notification-title-row">
                                <h3>
                                    @(notification.IsRead ? "Notification" : "New update")
                                </h3>

                                @if (notification.IsRead)
                                {
                                    <span class="notification-status read-status">
                                        Read
                                    </span>
                                }
                                else
                                {
                                    <span class="notification-status unread-status">
                                        Unread
                                    </span>
                                }
                            </div>

                            <p class="notification-message">
                                @notification.Message
                            </p>

                            <time class="notification-date"
                                  datetime="@notification.CreatedAt.ToUniversalTime().ToString("O")">
                                <span aria-hidden="true">◷</span>
                                @notification.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                            </time>
                        </div>

                        @if (!notification.IsRead)
                        {
                            <div class="notification-actions">
                                <form method="post"
                                      asp-page-handler="MarkAsRead">
                                    <input type="hidden"
                                           name="notificationId"
                                           value="@notification.NotificationId" />

                                    <button type="submit"
                                            class="notification-read-btn">
                                        Mark as read
                                    </button>
                                </form>
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </section>

    <footer class="notifications-footer">
        <a asp-page="/Dashboard/Index">← Back to dashboard</a>
    </footer>
</div>